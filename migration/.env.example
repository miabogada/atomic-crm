# Copy this file to migration/.env and fill in real values.
# migration/.env is gitignored — never commit it.

# Path to the Access split backend on this machine
MDB_PATH=/path/to/billing_be.mdb

# Exchange 2003 server
EXCHANGE_URL=http://10.0.0.12
EXCHANGE_USER=administrator
EXCHANGE_PASS=

# Supabase local instance
# Use the Secret key from `npx supabase status` (not the Publishable key)
# — the secret key bypasses RLS and can read users/contact_types
SUPABASE_REST_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=
